---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Page not found" description="This page does not exist." crumbs={[{ label: "Not found" }]}>
  <section class="nf">
    <h1>This page does not exist</h1>
    <p>The link may be old. Older research pages were removed when the tester restarted in November 2026.</p>
    <a class="btn btn-primary" href="/"><Icon name="back" /> Back to overview</a>
  </section>
</Base>
<style>
  .nf { padding: 5rem 0; display: grid; gap: 1rem; justify-items: start; }
  .nf p { color: var(--ink-2); max-width: 55ch; }
</style>
