---
import { getCollection, render } from "astro:content";
import Strategy from "../../../layouts/Strategy.astro";
import StatusChips from "../../../components/StatusChips.astro";
import { repoFile } from "../../../lib/site";
import { date } from "../../../lib/format";
export async function getStaticPaths() {
  return (await getCollection("strategies", (s) => s.data.stage !== "planned"))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const pine = d.pine ? repoFile(d.pine) : null;
---
<Strategy entry={entry} section="overview" title="Overview">
  <div class="overview-meta">
    <StatusChips features={d.features} />
    <p class="muted"><strong>Research verdict:</strong> {d.verdict}</p>
    <p class="muted">This verdict describes the existing research. Read Feature 0 for the original settings and its separate result.</p>
    <p class="links">
      {d.source && <a href={d.source.url} rel="noopener">{d.source.label}</a>}
      {pine && <a href={pine} rel="noopener">Pine v6 twin</a>}
      <span class="muted">Updated {date(d.updated)}</span>
    </p>
    <a class="start" href={`/strategies/${entry.id}/feature-0/`}>Start with Feature 0: original settings →</a>
  </div>
  <div class="prose"><Content /></div>
</Strategy>
<style>
  .overview-meta { display: grid; gap: 1rem; margin-bottom: 3rem; }
  .overview-meta p { max-width: 65ch; }
  .links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.875rem; }
  .start { justify-self: start; padding-block: 0.5rem; }
</style>
