---
import Crumbs from "../../components/Crumbs.astro";
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { date } from "../../lib/format";

export async function getStaticPaths() {
  const all = (await getCollection("journal")).sort((a, b) => a.data.date.getTime() - b.data.date.getTime() || a.id.localeCompare(b.id));
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, prev: all[i - 1], next: all[i + 1] } }));
}
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const strategy = entry.data.strategy ? await getEntry("strategies", entry.data.strategy) : undefined;
// A typo in frontmatter must fail the build, not silently drop the link.
if (entry.data.strategy && !strategy) throw new Error(`journal/${entry.id}: unknown strategy "${entry.data.strategy}"`);
// Planned strategies have no page yet, so they are named but not linked.
const strategyHref = strategy && strategy.data.stage !== "planned" ? `/strategies/${strategy.id}/` : undefined;
const kind = { milestone: "Milestone", result: "Result", "dead-end": "Dead end", review: "Review" } as const;
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class="wrap entry">
    <Crumbs items={[{ href: "/journal/", label: "Journal" }]} current={entry.data.title} />
    <p class="meta"><time class="mono" datetime={entry.data.date.toISOString()}>{date(entry.data.date)}</time> · {kind[entry.data.kind]}</p>
    <h1>{entry.data.title}</h1>
    <p class="summary">{entry.data.summary}</p>
    <div class="prose body"><Content /></div>
    {strategy && strategyHref && (
      <a class="strat" href={strategyHref}>
        <span class="muted">Strategy</span>
        <span>{strategy.data.title}</span>
        <Icon name="arrow-right" />
      </a>
    )}
    {strategy && !strategyHref && (
      <p class="strat">
        <span class="muted">Strategy</span>
        <span>{strategy.data.title}</span>
        <span class="muted">planned, no results yet</span>
      </p>
    )}
    <nav class="pn" aria-label="More entries">
      {prev ? <a href={`/journal/${prev.id}/`}><span class="muted">Earlier</span>{prev.data.title}</a> : <span />}
      {next ? <a class="r" href={`/journal/${next.id}/`}><span class="muted">Later</span>{next.data.title}</a> : <span />}
    </nav>
  </article>
</Base>
<style>
  .entry {
    max-width: 760px;
    padding-top: 3.5rem;
  }
  .meta {
    font-size: 0.875rem;
    color: var(--ink-3);
    margin-bottom: 0.8rem;
  }
  h1 {
    font-size: var(--step-3);
  }
  .summary {
    margin-top: 1rem;
    font-size: 1.1875rem;
    color: var(--ink-2);
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .body {
    margin-top: 2rem;
  }
  .strat {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 3rem;
    padding: 1rem 1.15rem;
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: 0 0 0 1px var(--line-2) inset;
    text-decoration: none;
    font-weight: 500;
  }
  .strat :global(svg) {
    margin-left: auto;
    transition: transform 0.3s var(--ease-out);
  }
  .strat:hover :global(svg) {
    transform: translateX(3px);
  }
  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .pn a {
    display: grid;
    gap: 0.2rem;
    text-decoration: none;
    font-weight: 500;
  }
  .pn .muted {
    font-size: 0.8125rem;
    font-weight: 400;
  }
  .pn .r {
    text-align: right;
  }
</style>
