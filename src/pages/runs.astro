---
import Base from "../layouts/Base.astro";
import GateCells from "../components/GateCells.astro";
import ReadingGuide from "../components/ReadingGuide.astro";
import { R, strategies, strategyById, yearRange, gatesPassed, swatch } from "../lib/data";
import { usdK, pct, int } from "../lib/format";
const years = yearRange();
const devRuns = R.variants.filter((v) => v.period === "dev");
const rows = [...devRuns].sort((a, b) => gatesPassed(b) - gatesPassed(a) || b.profit_factor - a.profit_factor);
---
<Base title="All test runs" description="Every version of every CL strategy tested, with all five pass checks, sortable and filterable." crumbs={[{ label: "All test runs" }]}>
  <header class="head">
    <h1>All test runs</h1>
    <p>
      Every version of every idea. The tester keeps a permanent log of {R.ledger_rows} runs, because some versions were
      run again after bug fixes. Only the newest run of each version is shown here.
    </p>
  </header>

  <section class="panel" data-runs>
    <div class="tools" role="group" aria-label="Filter by strategy">
      <button type="button" class="pill" aria-pressed="true" data-filter="all">All <span class="num">{rows.length}</span></button>
      {strategies.map((s) => (
        <button type="button" class="pill" aria-pressed="false" data-filter={s.id}>
          <i style={swatch(s.color, s.dash)}></i>{s.name} <span class="num">{s.variants.length}</span>
        </button>
      ))}
    </div>
    <div class="table-wrap">
      <table data-sortable>
        <thead>
          <tr>
            <th>Strategy · version</th>
            <th class="r">Net profit</th>
            <th class="r">Win rate</th>
            <th class="r">Biggest drop</th>
            <th>Trades<span class="need">200+</span></th>
            <th>Profit factor<span class="need">1.25+</span></th>
            <th>Years in profit<span class="need">70%+</span></th>
            <th>Pass rate<span class="need">50%+</span></th>
            <th data-dir="asc">Cost per pass<span class="need">≤ $500</span></th>
          </tr>
        </thead>
        <tbody>
          {rows.map((v) => {
            const s = strategyById(v.strategy);
            return (
              <tr data-strategy={v.strategy}>
                <td>
                  <a class="sname" href={`/strategies/${s.slug}/`}>
                    <i style={swatch(s.color, s.dash)}></i>
                    <span><b>{s.name}</b><small>{v.label} · best of {v.best_of}</small></span>
                  </a>
                </td>
                <td class="r num strong" data-v={v.net}>{usdK(v.net)}</td>
                <td class="r num" data-v={v.win_rate}>{pct(v.win_rate, 0)}</td>
                <td class="r num" data-v={v.max_drawdown}>{usdK(v.max_drawdown)}</td>
                <GateCells variant={v} />
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <ReadingGuide />
    <p class="note">
      All runs: build data {years}, one contract, $4.04 fee per round trip, limit entries that fill on a touch. In-sample.
      Showing <span data-count>{rows.length}</span> of {rows.length} versions · {int(devRuns.reduce((n, v) => n + v.trades, 0))} trades. Build-period (dev) runs only; validation checks are on each strategy page.
    </p>
  </section>
</Base>
<script src="../lib/runs.client.ts"></script>
<style>
  .head { position: relative; padding: clamp(2rem, 5vw, 3.25rem) 0 1.75rem; }
  .head::before {
    content: ""; position: absolute; z-index: -1; inset: -3.5rem -20% auto; height: 22rem; pointer-events: none;
    background: radial-gradient(34rem 16rem at 25% 0%, var(--sky-glow), transparent 70%);
  }
  .head p { margin-top: 0.8rem; max-width: 68ch; color: var(--ink-2); }
  .tools { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 1rem 1.1rem 0.5rem; }
  .pill {
    display: inline-flex; align-items: center; gap: 0.45rem; height: 2rem; padding: 0 0.75rem; border-radius: 99px;
    border: 1px solid var(--line-hi); background: transparent; color: var(--ink-2); font: 500 0.8rem/1 var(--sans); cursor: pointer;
    transition: background 0.15s var(--ease), color 0.15s var(--ease);
  }
  .pill:hover { color: var(--ink); background: rgb(255 255 255 / 0.05); }
  .pill[aria-pressed="true"] { background: var(--btn); color: var(--btn-ink); border-color: transparent; }
  .pill i { width: 8px; height: 8px; border-radius: 2px; }
  .pill .num { opacity: 0.6; }
  .table-wrap { padding: 0 0.5rem; }
  th .need { display: block; font-weight: 400; color: var(--ink-3); margin-top: 0.1rem; }
  .sname { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; }
  .sname i { flex: none; width: 4px; height: 2rem; border-radius: 2px; }
  .sname b { display: block; font-weight: 600; }
  .sname small { display: block; color: var(--ink-3); font-size: 0.75rem; }
  .sname:hover b { text-decoration: underline; text-underline-offset: 0.2em; }
  .strong { font-weight: 600; }
  tr[hidden] { display: none; }
  .note { padding: 0.9rem 1.25rem 1.1rem; border-top: 1px solid var(--line); font-size: 0.8rem; color: var(--ink-3); }
</style>
