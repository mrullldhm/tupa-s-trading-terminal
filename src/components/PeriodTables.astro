---
import { usd, tone } from "../lib/format";
import { EXPORT_VERSION, strategyData } from "../lib/data";
import { SCENARIO_KEYS, isPeriodTable, type PeriodTable, type PeriodFile } from "../lib/periods";
interface Props { strategy: string; dataKey: string; year: PeriodTable; label: string }
const { strategy, dataKey, label } = Astro.props;
const generated = strategyData(strategy).generated_utc;
const files = import.meta.glob<PeriodFile>("../../public/data/*/*/day-my.json", { eager: true, import: "default" });
const file = files[`../../public/data/${strategy}/${dataKey}/day-my.json`];
if (!isPeriodTable(file) || file.export_version !== EXPORT_VERSION || file.generated_utc !== generated || file.timezone !== "Asia/Kuala_Lumpur") {
  throw new Error(`Daily results for ${strategy}/${dataKey} do not match this export. Run npm run export.`);
}
const days = file.periods.map((day, i) => ({ day, net: SCENARIO_KEYS.map(k => file.net[k][i]) }))
  .filter(({ net }) => net[0] !== null)
  .sort((a, b) => b.day.localeCompare(a.day));
const first = days.slice(0, 30);
---
<section class="periods" data-periods data-strategy={strategy} data-key={dataKey} data-version={EXPORT_VERSION}
  data-generated={generated} data-total={days.length} data-replay={import.meta.env.DEV ? "local" : undefined} aria-label={`${label}: daily results`}>
  <div class="daily-heading"><h4>Day by day</h4><span>Latest first · Malaysia time (UTC+8)</span></div>
  <p class="note">Net profit after commission. In-sample. Trades are grouped by the Malaysian date they closed.
    Days with no closed trades are left out; a dash means no trades closed.</p>
  <p class="note" data-chart-hint hidden>Select a day to show its trades. Select it again to hide the chart.</p>
  <div class="table-scroll tall">
    <table class="data">
      <caption class="sr-only">{label}: daily net profit after commission, latest first</caption>
      <thead><tr><th scope="col">Day (MYT)</th>{["Net profit"].map(h => <th scope="col" class="num">{h}</th>)}</tr></thead>
      <tbody data-rows>
        {first.map(({ day, net }) => <tr data-day={day}>
          <th scope="row" class="mono"><span data-day-label>{day}</span></th>
          {net.map(v => <td class:list={["num", tone(v)]}>{v === null ? <span aria-label="no trades">–</span> : usd(v, { cents: false })}</td>)}
        </tr>)}
      </tbody>
    </table>
  </div>
  <div class="daily-footer">
    <button type="button" class="toggle" data-more hidden>Show earlier days</button>
    <span class="count" data-count>{first.length} of {days.length.toLocaleString("en-US")} days</span>
    <p class="status" data-status role="status"></p>
  </div>
  <noscript><p class="note">The latest 30 days are shown. Enable JavaScript to browse earlier days and open charts.</p></noscript>
</section>
<script>
  import { bootDailyResults } from "../lib/daily-results.client";
  bootDailyResults();
</script>
<style>
  .periods { margin-top: 1.5rem; }
  .daily-heading, .daily-footer { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1rem; }
  .daily-heading h4 { margin: 0; font-size: 1rem; font-weight: 500; }
  .daily-heading span, .count { font-size: 0.8125rem; color: var(--ink-3); }
  .note { max-width: var(--measure); margin: 0.5rem 0 0.9rem; font-size: 0.8125rem; color: var(--ink-2); }
  .daily-footer { margin-top: 0.75rem; align-items: center; }
  .toggle { min-height: 44px; padding: 0 0.95rem; border: 0; border-radius: 9px; font: 500 0.875rem/1 var(--font);
    color: var(--ink); background: var(--panel-2); box-shadow: 0 0 0 1px var(--line-2) inset; cursor: pointer; }
  .toggle:hover:not(:disabled) { background: var(--panel-3); }
  .toggle:disabled { cursor: progress; color: var(--ink-2); }
  .status { font-size: 0.8125rem; color: var(--short); }
  .status:empty { display: none; }
  .tall { max-height: 620px; overflow: auto; overscroll-behavior: contain; }
  .tall:has([data-open]) { max-height: none; }
  .tall :global(thead th) { position: sticky; top: 0; z-index: 1; }
  .periods :global(table.data) { min-width: 0; }
  .periods :global(table.data:not(.replay-trades)) { table-layout: fixed; width: 100%; }
  .periods :global(table.data:not(.replay-trades) > thead > tr > th:first-child) { width: 48%; }
  .periods :global([data-day][data-interactive]) { cursor: pointer; }
  .periods :global([data-day][data-interactive]:hover), .periods :global([data-day][data-open]) { background: var(--panel-2); }
  .periods :global(.day-toggle) { display: flex; align-items: center; gap: 0.5rem; min-height: 44px; width: 100%;
    background: none; border: 0; padding: 0; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .periods :global(.day-toggle svg) { width: 14px; height: 14px; flex: none; transition: transform 0.2s; }
  .periods :global(.day-toggle span) { white-space: nowrap; }
  .periods :global([aria-expanded="true"] svg) { transform: rotate(90deg); }
  .periods :global(.replay-cell) { padding: 1rem; white-space: normal; }
  .periods :global(.replay-cell > *) { min-width: 0; max-width: 100%; }
  .periods :global(.replay-toolbar) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .periods :global(.replay-toolbar select) { min-height: 44px; margin-left: 0.5rem; color: var(--ink); background: var(--panel-2); border: 1px solid var(--line-2); border-radius: 7px; padding: 0 0.5rem; font: inherit; }
  .periods :global(.replay-canvas) { width: 100%; height: 360px; margin-top: 1rem; }
  .periods :global(.replay-note) { font: 400 0.8125rem/1.6 var(--font); color: var(--ink-2); margin: 0.75rem 0; }
  .periods :global(.replay-trades) { min-width: 520px; font-size: 0.8125rem; }
  .periods :global(.replay-trades th), .periods :global(.execution-time), .periods :global(.execution-price) { white-space: nowrap; }
  .periods :global(.replay-legend) { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; font: 400 0.8125rem/1.5 var(--font); color: var(--ink-2); }
  .periods :global(.replay-legend span) { display: inline-flex; align-items: center; gap: 0.4rem; }
  .periods :global(.replay-legend i) { width: 14px; border-top: 2px solid var(--legend-color); }
  @media (max-width: 640px) {
    .periods :global(th), .periods :global(td) { padding-inline: 0.55rem; }
    .periods :global(table.data) { font-size: 0.8125rem; }
    .periods :global(.replay-cell) { padding: 0.65rem; }
    .periods :global(.replay-canvas) { height: 300px; }
  }
</style>
