---
import Frame from "./Frame.astro";
import Icon from "./Icon.astro";
import type { Story } from "../lib/illustrative/types";

interface Props {
  story: Story;
}
const { story } = Astro.props;
const { steps } = story;
// One legend entry per indicator; Supertrend has two tones (up / down) under one name.
const legend = [...new Set((story.overlays ?? []).map((o) => o.label))].map((label) => ({
  label,
  tones: (story.overlays ?? []).filter((o) => o.label === label).map((o) => o.tone),
}));
---
<Frame class="annotated" label={story.label}>
  <div class="chart-root" data-chart="annotated" data-candles={JSON.stringify(story.candles)} data-steps={JSON.stringify(steps)} data-overlays={JSON.stringify(story.overlays ?? [])} tabindex="0" role="group" aria-label="Example trade, step by step. Left and right arrow keys move between steps.">
    <div class="top">
      <span class="sym mono">
        {story.symbol}
        {legend.map((l) => (
          <span class="key">
            {l.tones.map((t) => <i class={`swatch ${t}`} aria-hidden="true"></i>)}
            {l.label}
          </span>
        ))}
      </span>
      <span class="illus"><Icon name="flask" size={13} /> Illustrative prices, not real market data</span>
    </div>
    <div class="canvas" data-canvas role="img" aria-label={story.summary}></div>
    <div class="explain">
      <div class="said" aria-live="polite" aria-atomic="true">
        <p class="count mono" data-count>Step 1 of {steps.length}</p>
        <h3 data-title>{steps[0].title}</h3>
        <p class="text" data-text>{steps[0].text}</p>
      </div>
      <div class="controls">
        <button type="button" class="nav" data-prev aria-label="Previous step"><Icon name="chevron-left" /></button>
        <ol class="dots">
          {steps.map((s, i) => (
            <li><button type="button" data-dot aria-label={`Step ${i + 1}: ${s.title}`} aria-current={i === 0 ? "step" : "false"}></button></li>
          ))}
        </ol>
        <button type="button" class="nav" data-next aria-label="Next step"><Icon name="chevron-right" /></button>
      </div>
    </div>
  </div>
</Frame>
<script>
  import "../lib/charts.client";
</script>
<style>
  .chart-root {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    grid-template-rows: auto 1fr;
    min-height: 440px;
  }
  .chart-root:focus-visible {
    outline-offset: -3px;
  }
  .top {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .sym {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .swatch {
    width: 12px;
    height: 2px;
    border-radius: 1px;
  }
  .swatch + .swatch {
    margin-left: -0.25rem;
  }
  .swatch.long {
    background: var(--long);
  }
  .swatch.short {
    background: var(--short);
  }
  .swatch.ink {
    height: 1px;
    background: rgb(249 249 249 / 0.85);
  }
  .swatch.dim {
    height: 1px;
    background: rgb(249 249 249 / 0.35);
  }
  .illus {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--amber);
  }
  .canvas {
    min-width: 0;
    overflow: hidden;
    min-height: 380px;
    padding: 0.5rem 0 0.25rem;
  }
  .explain {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    border-left: 1px solid var(--line);
    background: var(--panel);
  }
  .count {
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  h3 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  .text {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .controls {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-top: 1rem;
  }
  .nav {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: 0;
    color: var(--ink);
    background: var(--panel-3);
    box-shadow: 0 0 0 1px var(--line-2) inset;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .nav:hover:not(:disabled) {
    background: #2a2a2f;
  }
  .nav:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .said {
    display: grid;
    gap: 0.6rem;
  }
  .dots {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    flex: 1;
    justify-content: center;
  }
  .dots button {
    width: 26px;
    height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
  }
  .dots button::after {
    content: "";
    position: absolute;
    inset: 18px 4px;
    border-radius: 2px;
    background: var(--line-3);
    transition: background-color 0.2s, box-shadow 0.3s;
  }
  .dots button[aria-current="step"]::after {
    background: var(--ink);
    box-shadow: 0 0 10px rgb(255 255 255 / 0.6);
  }
  @media (max-width: 820px) {
    /* minmax(0, …), not 1fr: a bare 1fr keeps the chart canvas's old pixel width after a rotate or resize. */
    .chart-root {
      grid-template-columns: minmax(0, 1fr);
    }
    .canvas {
      min-height: 300px;
    }
    .explain {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
