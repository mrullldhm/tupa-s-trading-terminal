---
// The research path drawn as a stack (Graphite's stacked-PR line): one node per stage, the unbuilt stage dashed.
import { STAGES } from "../lib/stages";
const stages = [
  { name: "Write it twice", text: "Each strategy is written in Python for the tester and in Pine for TradingView, so any trade can be checked on a real chart.", state: "done" },
  { name: `${STAGES.f1.name} (${STAGES.f1.tag})`, text: "Run every combination of settings over 16 years of 1-minute data. Show the best result after commission.", state: "done" },
  { name: `${STAGES.f2.name} (${STAGES.f2.tag})`, text: "Write the guess down first. Search only pre-2024 data, log every try, and review the results.", state: "done" },
  { name: "Independent review", text: "Codex reviews the code, then rebuilds headline results with its own engine. A result only counts when the trades match.", state: "done" },
  { name: `${STAGES.f3.name} (${STAGES.f3.tag})`, text: "Re-run the search year by year on the same pre-2024 data, and ask whether the winner beats the best of its lucky tries. Rules for passing are written first.", state: "done" },
  { name: `${STAGES.f4.name} (${STAGES.f4.tag})`, text: "Only for a result that passes F3: would it pass a Topstep 50K evaluation, with its loss limits and size caps, better than random entries would?", state: "pending" },
  { name: `${STAGES.f5.name} (${STAGES.f5.tag})`, text: "One run of the frozen strategy and prop rules on the reserved 2024+ data. Used once, never tuned on.", state: "pending" },
];
// A connector into a pending stage is dashed.
const into = stages.map((s, i) => stages[i + 1]?.state === "pending");
---
<ol class="stack">
  {stages.map((s, i) => (
    <li class:list={[s.state, { "to-pending": into[i] }]}>
      <span class="node" aria-hidden="true"></span>
      <div>
        <h3>{s.name}{s.state === "pending" && <span class="tag">Not built yet</span>}</h3>
        <p>{s.text}</p>
      </div>
    </li>
  ))}
</ol>
<style>
  .stack {
    position: relative;
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 1.25rem;
  }
  li:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 8.5px;
    top: 22px;
    height: calc(100% + 2rem - 18px);
    width: 1px;
    background: linear-gradient(var(--line-3), rgb(255 255 255 / 0.4));
  }
  li.to-pending::before {
    background: repeating-linear-gradient(var(--line-3) 0 4px, transparent 4px 9px);
  }
  .node {
    margin-top: 4px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 0 2px var(--ink) inset, 0 0 14px rgb(255 255 255 / 0.45);
  }
  .pending .node {
    box-shadow: 0 0 0 1.5px var(--line-3) inset;
    background: repeating-linear-gradient(135deg, transparent 0 3px, rgb(255 255 255 / 0.12) 3px 4px);
  }
  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-1);
  }
  .pending h3 {
    color: var(--ink-2);
  }
  .tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    color: var(--ink-3);
    box-shadow: 0 0 0 1px var(--line-2) inset;
  }
  p {
    margin-top: 0.35rem;
    color: var(--ink-2);
    max-width: 60ch;
  }
</style>
