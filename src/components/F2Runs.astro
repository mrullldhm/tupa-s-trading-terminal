---
import Badge from "./Badge.astro";
import Callout from "./Callout.astro";
import CurveChart from "./CurveChart.astro";
import ScenarioTable from "./ScenarioTable.astro";
import { strategyData, sessionLabel, SESSION_ORDER, MIN_ELIGIBLE_TRADES } from "../lib/data";
import { F2_VERDICTS } from "../data/verdicts";
import { usd, int, tone } from "../lib/format";
import Pending from "./Pending.astro";
import PeriodTables from "./PeriodTables.astro";
import { plainSettings, samplerLabel } from "../lib/labels";

// reservedLook: a filter check outside the protocol saw 2024+ data (fair_price_reversal, docs R6)
interface Props { strategy: string; reservedLook?: boolean }
const { strategy, reservedLook = false } = Astro.props;
const data = strategyData(strategy);
const f2 = data.features.f2;
// No search yet (null or no runs) renders a pending state; a run without a written verdict still fails the build.
const ready = !!f2 && f2.runs.length > 0;
const verdicts = F2_VERDICTS[strategy] ?? {};
const missing = (f2?.runs ?? []).filter((r) => !verdicts?.[r.run_id]).map((r) => r.run_id);
if (missing.length) throw new Error(`F2Runs: no verdict written for ${missing.join(", ")} in src/data/verdicts.ts`);
const runs = [...(f2?.runs ?? [])].sort(
  (a, b) => SESSION_ORDER.indexOf(a.variant) - SESSION_ORDER.indexOf(b.variant) || a.space.localeCompare(b.space),
);
const candidates = runs.filter((r) => verdicts[r.run_id].verdict === "candidate");
const stale = candidates.filter((r) => !r.periods_year).map((r) => r.run_id);
if (stale.length) throw new Error(`F2Runs: ${stale.join(", ")} became a candidate after the last export; run npm run export`);
const spaceLabel = { filters: "Filters only", full: "Settings + filters" } as const;
const trialSizes = [...new Set(runs.map((r) => r.trials))].sort((a, b) => a - b).join(" or ");
const trialsBySession = new Map<string, number>();
runs.forEach((r) => trialsBySession.set(r.variant, (trialsBySession.get(r.variant) ?? 0) + r.trials));
const perSessionValues = [...new Set(trialsBySession.values())];
const perSessionText = perSessionValues.length === 1 ? `${int(perSessionValues[0])} per variant` : "split unevenly across variants";
const f1 = data.features.f1;
const f1GridText = f1.grid_size.map((n) => int(n)).join(" / ");
function baselineBefore(variant: string, cutoff: string | null) {
  const base = f1.variants[variant];
  if (!base) throw new Error(`F2Runs: no F1 baseline for session "${variant}"`);
  const curve = base.curve_month_end_closed_pnl["0"];
  return cutoff ? curve.filter(([m]) => m < cutoff.slice(0, 7)) : curve;
}
---
{!ready && (
  <Pending heading="Not run yet">
    No F2 search has been run for this strategy. When one is, every run will be listed here with its verdict,
    including the ones that fail.
  </Pending>
)}
{ready && f2 && <>
<Callout tone="warn" title="Read this before the numbers">
  <p>Evaluated on data before 2024 only. But the starting settings were picked in F1 using all data up to
  2026{reservedLook && ", and an early filter check also saw 2024+ data"}. So 2024+ is reserved, but
  it is <strong>not</strong> a clean out-of-sample test.</p>
  <p>Each result is the best of its run ({trialSizes} tries). Across all sessions the search tried{" "}
  {int(f2.total_trials)} settings ({perSessionText}), on top of the {f1GridText}-setting F1 grids. That
  took{" "}{int(f2.total_engine_evaluations)} engine runs in the local ledger, including historical work, reruns and checks.</p>
</Callout>

<div class="table-scroll runs">
  <table class="data">
    <caption class="sr-only">All {runs.length} F2 search runs with their verdicts</caption>
    <thead>
      <tr>
        <th scope="col">Run</th>
        <th scope="col">Best setting found</th>
        <th scope="col" class="num">Net profit</th>
        <th scope="col" class="num">Trades</th>
        <th scope="col">Verdict</th>
      </tr>
    </thead>
    <tbody>
      {runs.map((r) => {
        const v = verdicts[r.run_id];
        const isCandidate = v.verdict === "candidate";
        const s0 = r.scenarios["0"];
        return (
          <tr>
            <th scope="row">
              {sessionLabel(r.variant)} · {spaceLabel[r.space as keyof typeof spaceLabel] ?? r.space}
              <span class="sub">{samplerLabel(r.sampler)} · {r.trials} tries</span>
            </th>
            <td class="setting"><ul>{plainSettings(r.winner).map((x) => <li>{x}</li>)}</ul></td>
            <td class:list={["num", tone(s0.net_profit)]} data-label="Net profit:">{usd(s0.net_profit)}</td>
            <td class="num" data-label="Trades:">{int(s0.total_closed_trades)}</td>
            <td class="verdict">
              {(
                <>
                  <Badge tone={isCandidate ? "done" : "rejected"} icon={isCandidate ? "check" : "x"}>
                    {isCandidate ? "Candidate" : "Rejected"}
                  </Badge>
                  <p>{v.reason}</p>
                </>
              )}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
<p class="rule muted">These searches use the fixed owner swings and limit entries, with at least {MIN_ELIGIBLE_TRADES} closed trades for eligibility.
Commission is included with no added slippage. Candidate labels identify configurations for research validation.</p>

{candidates.map((r) => (
  <section class="candidate">
    <h3>{sessionLabel(r.variant)} candidate: {plainSettings(r.winner).join(", ")}</h3>
    <ScenarioTable scenarios={r.scenarios} objectiveNote caption={`F2 candidate, ${sessionLabel(r.variant)}`} />
    <CurveChart
      title={`${sessionLabel(r.variant)} candidate vs. F1 baseline`}
      caption={`Month-end cumulative closed-trade P&L after commission. The candidate line covers the development interval only (before 2024). The baseline line is the F1 top setting over its full test period, cut to the same months for comparison.`}
      series={[
        { label: "Candidate", tone: "long", points: r.curve_month_end_closed_pnl["0"] },
        {
          label: "F1 baseline",
          tone: "faint",
          points: baselineBefore(r.variant, r.interval[1]),
        },
      ]}
    />
    {r.periods_year && (
      <PeriodTables strategy={strategy} dataKey={`f2-${r.run_id}`} year={r.periods_year} label={`F2 ${sessionLabel(r.variant)} candidate`} />
    )}
  </section>
))}
</>}
<style>
  .runs .sub {
    display: block;
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--ink-3);
    margin-top: 0.2rem;
  }
  .runs :global(th[scope="row"]) {
    min-width: 170px;
  }
  .setting ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--ink);
    min-width: 180px;
    max-width: 260px;
  }
  .setting li + li {
    margin-top: 0.2rem;
  }
  .verdict {
    min-width: 240px;
  }
  /* Narrow screens: each run becomes a stacked block instead of a 5-column table. */
  @media (max-width: 760px) {
    .runs :global(thead) {
      display: none;
    }
    .runs :global(table),
    .runs :global(tbody),
    .runs :global(tr),
    .runs :global(th),
    .runs :global(td) {
      display: block;
      width: 100%;
      min-width: 0;
      text-align: left;
    }
    .runs :global(tr) {
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--line);
    }
    .runs :global(td),
    .runs :global(th) {
      border: 0;
      padding: 0.3rem 0.95rem;
    }
    .runs :global(table.data td.num) {
      text-align: left;
    }
    .runs :global(td.num)::before {
      content: attr(data-label) " ";
      font-family: var(--font);
      color: var(--ink-3);
    }
    .setting ul {
      max-width: none;
    }
  }
  .verdict p {
    margin-top: 0.45rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .rule {
    font-size: 0.875rem;
    max-width: var(--measure);
  }
  .candidate {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* shrink back after a resize; charts set a pixel width */
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .candidate h3 {
    font-size: var(--step-1);
  }
  .candidate h3 code {
    font-size: 0.85em;
  }
</style>
