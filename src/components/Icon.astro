  warn: '<path d="M8 2.2 14.3 13H1.7Z"/><path d="M8 6.5v3"/><circle cx="8" cy="11.3" r=".5"/>',
} as const;
export type IconName = keyof typeof P;
interface Props { name: IconName; size?: number; class?: string; label?: string }
const { name, size = 16, class: cls, label } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
  stroke-linecap="round" stroke-linejoin="round" role={label ? "img" : undefined} aria-label={label}
  aria-hidden={label ? undefined : "true"} set:html={P[name]} />
