---
// One stroke family (1.5px, round caps) for every icon on the site.
interface Props {
  name: "arrow-right" | "arrow-up-right" | "check" | "clock" | "dash" | "x" | "chevron-left" | "chevron-right" | "lock" | "flask";
  size?: number;
  class?: string;
}
const { name, size = 16, class: cls } = Astro.props;
const paths: Record<Props["name"], string> = {
  "arrow-right": "M3.5 8h9M8.5 4l4 4-4 4",
  "arrow-up-right": "M5 11l6-6M6 5h5v5",
  check: "M3.5 8.5l3 3 6-7",
  clock: "M8 4.5V8l2.2 1.6M14 8A6 6 0 1 1 2 8a6 6 0 0 1 12 0Z",
  dash: "M4.5 8h7",
  x: "M4.5 4.5l7 7M11.5 4.5l-7 7",
  "chevron-left": "M10 3.5L5.5 8l4.5 4.5",
  "chevron-right": "M6 3.5L10.5 8 6 12.5",
  lock: "M4.5 7.5V5.8a3.5 3.5 0 0 1 7 0v1.7M3.5 7.5h9v6h-9z",
  flask: "M6.5 2.5h3M7 2.5v4L3.6 12.2a1 1 0 0 0 .9 1.3h7a1 1 0 0 0 .9-1.3L9 6.5v-4M5 10h6",
};
---
<svg class={cls} width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name]} /></svg>
