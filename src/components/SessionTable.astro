---
// Source: docs/SESSIONS.md (open minutes measured on CL volume) and the strategy report.
const rows = [
  { s: "New York", open: "21:00 US summer · 22:00 US winter", anchor: "20:59 / 21:59", flat: "02:30 / 03:30 next day" },
  { s: "London", open: "15:00 UK summer · 16:00 UK winter", anchor: "14:59 / 15:59", flat: "20:00 / 21:00" },
  { s: "Asia", open: "09:00 all year", anchor: "08:59", flat: "15:00" },
];
---
<div class="table-scroll">
  <table class="data">
    <caption class="sr-only">CL session opens used as anchors</caption>
    <thead><tr><th scope="col">Session</th><th scope="col">Open (MYT)</th><th scope="col">Anchor (MYT)</th><th scope="col">Flat at (MYT)</th></tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr><th scope="row">{r.s}</th><td>{r.open}</td><td class="mono">{r.anchor}</td><td>{r.flat}</td></tr>
      ))}
    </tbody>
  </table>
</div>
<p class="note">CL trades almost 24 hours, so the exchange has no official sessions. Each open is the minute where
volume jumps, measured on CL data for 2024 and 2025. All times are Malaysia time (UTC+8). Paired times show
summer / winter in the session’s home country; Malaysia does not change clocks.</p>
<style>
  .note {
    margin-top: 0.7rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
</style>
