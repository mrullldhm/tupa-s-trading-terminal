---
import Badge from "./Badge.astro";
type S = "done" | "in-progress" | "pending" | "not-started";
interface Props { features: { f1: S; f2: S; f3: S } }
const { features } = Astro.props;
const label = { f1: "Feature 1 test", f2: "Feature 2 search", f3: "Feature 3 validation" } as const;
const word = { done: "done", "in-progress": "in progress", pending: "pending", "not-started": "not started" } as const;
---
<ul class="chips" aria-label="Progress">
  {(Object.keys(label) as (keyof typeof label)[]).map((k) => (
    <li>
      <Badge tone={features[k] === "done" ? "done" : "pending"} icon={features[k] === "done" ? "check" : "clock"}>
        {label[k]}<span class="sr-only">: {word[features[k]]}</span>
      </Badge>
    </li>
  ))}
</ul>
<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
