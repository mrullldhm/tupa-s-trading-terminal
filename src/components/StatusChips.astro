---
import Badge from "./Badge.astro";
import { STAGES, STAGE_KEYS, STAGE_STATE_WORD } from "../lib/stages";
type S = keyof typeof STAGE_STATE_WORD;
interface Props { features: { f1: S; f2: S; f3: S; f4: S; f5: S } }
const { features } = Astro.props;
---
<ul class="chips" aria-label="Test stages">
  {STAGE_KEYS.map((k) => (
    <li>
      <Badge tone={features[k] === "done" ? "done" : "pending"} icon={features[k] === "done" ? "check" : "clock"}>
        <span class="tag">{STAGES[k].tag}</span> {STAGES[k].name}<span class="sr-only">: {STAGE_STATE_WORD[features[k]]}</span>
      </Badge>
    </li>
  ))}
</ul>
<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tag {
    font-family: var(--mono);
    font-size: 0.6875rem;
    opacity: 0.75;
  }
</style>
