---
import Tabs from "./Tabs.astro";
import ScenarioTable from "./ScenarioTable.astro";
import CurveChart from "./CurveChart.astro";
import PeriodTables from "./PeriodTables.astro";
import MetricWinners from "./MetricWinners.astro";
import { strategyData, sessionLabel, SESSION_ORDER } from "../lib/data";
import { int, date } from "../lib/format";
import { targetLabel } from "../lib/labels";

interface Props { strategy: string; paramLabels?: Record<string, string> }
const { strategy, paramLabels = {} } = Astro.props;
const f1 = strategyData(strategy).features.f1;
const keys = SESSION_ORDER.filter((k) => k in f1.variants);
const unknown = Object.keys(f1.variants).filter((k) => !SESSION_ORDER.includes(k));
if (unknown.length) throw new Error(`F1Results: unknown sessions ${unknown.join(", ")}`);
const plabel = (k: string) => paramLabels[k] ?? k;
---
<Tabs name="Session" tabs={keys.map((k) => ({ id: `f1-${k}`, label: sessionLabel(k) }))}>
  {keys.map((k, i) => {
    const v = f1.variants[k];
    const s0 = v.scenarios["0"];
    return (
      <section id={`panel-f1-${k}`} role="tabpanel" tabindex="0" aria-labelledby={`tab-f1-${k}`} hidden={i !== 0} class="panel">
        <MetricWinners strategy={strategy} session={sessionLabel(k)} objectives={f1.objectives}
          selection={v.metric_selection} paramLabels={paramLabels} />
        <details class="historical">
        <summary>{v.reference_historical !== false ? "Historical net-profit reference" : "Net-profit reference across all settings"}</summary>
        <p class="period muted">{v.reference_historical !== false
          ? "This saved report predates the multi-metric run and the recent entry-rule updates."
          : "The highest net-profit setting before applying the minimum trade count used in the separate metric rankings."}</p>
        <p class="params">
          <span class="muted">Best of {int(v.grid_size)} settings:</span>{" "}
          {Object.entries(v.params).filter(([p]) => p !== "session").map(([p, val]) => (
            <code>{plabel(p)} {targetLabel(String(val))}</code>
          ))}
        </p>
        <p class="period muted">
          Tested {date(s0.period_start)} to {date(s0.period_end)}. In-sample: the settings were picked on this same data.
        </p>
        <ScenarioTable scenarios={v.scenarios} caption={`F1, ${sessionLabel(k)} session, top combination, commission included`} />
        <CurveChart
          title={`${sessionLabel(k)}: cumulative closed-trade P&L`}
          caption="Month-end values of closed-trade profit after commission. Swings inside a month and open trades are not shown, so read drawdown from the table, not from this chart."
          series={[
            { label: "Net profit", tone: "ink", points: v.curve_month_end_closed_pnl["0"] },
          ]}
        />
        <PeriodTables strategy={strategy} dataKey={`f1-${k}`} year={v.periods_year} label={`F1, ${sessionLabel(k)} session, top combination`} />
        </details>
      </section>
    );
  })}
</Tabs>
<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* shrink back after a resize; charts set a pixel width */
    gap: 1.5rem;
  }
  .params {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9375rem;
  }
  .period {
    margin-top: -1rem;
    max-width: var(--measure);
    font-size: 0.875rem;
  }
  .historical { border-top: 1px solid var(--line); padding-top: 1rem; }
  .historical summary { cursor: pointer; padding-block: 0.75rem; font-size: 0.9375rem; color: var(--ink-2); }
  .historical > * + * { margin-top: 1.25rem; }
</style>
