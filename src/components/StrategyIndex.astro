---
import { getCollection } from "astro:content";
import Badge from "./Badge.astro";
import Icon from "./Icon.astro";
import { STAGES, STAGE_KEYS, STAGE_STATE_WORD } from "../lib/stages";

interface Props { interactiveHeading?: string }
const { interactiveHeading = "Strategies" } = Astro.props;
const all = (await getCollection("strategies")).sort((a, b) => a.data.order - b.data.order);
const tested = all.filter((s) => s.data.stage === "tested").length;
const building = all.filter((s) => s.data.stage === "building").length;
const planned = all.length - tested - building;
---
<div class="terminal" data-strategy-index>
  <aside class="side">
    <p class="side-h" id="filter-h">Show</p>
    <ul class="filters" aria-labelledby="filter-h">
      <li><button type="button" data-filter="all" aria-pressed="true"><span>All strategies</span><span class="mono">{all.length}</span></button></li>
      <li><button type="button" data-filter="tested" aria-pressed="false"><span>Tested</span><span class="mono">{tested}</span></button></li>
      <li><button type="button" data-filter="building" aria-pressed="false"><span>In development</span><span class="mono">{building}</span></button></li>
      <li><button type="button" data-filter="planned" aria-pressed="false"><span>Planned</span><span class="mono">{planned}</span></button></li>
    </ul>
    <p class="side-h market-h">Market</p>
    <p class="market">CL1! · 1 minute</p>
  </aside>
  <div class="main">
    <div class="titlebar">
      <h2 class="tb-h" id="strategies-index-h">{interactiveHeading}</h2>
      <p class="legend">{STAGE_KEYS.map((k, i) => <>{i > 0 && " · "}<span class="mono">{STAGES[k].tag}</span> {STAGES[k].short}</>)}</p>
    </div>
    <ul class="rows">
      {all.map((s) => {
        const href = s.data.stage !== "planned" ? `/strategies/${s.id}/` : undefined;
        const El = href ? "a" : "div";
        return (
          <li data-stage={s.data.stage}>
            <El class:list={["row", { link: !!href }]} href={href}>
              <div class="name">
                <span class="title">{s.data.title}</span>
                <span class="summary">{s.data.summary}</span>
              </div>
              <div class="chips">
                {STAGE_KEYS.map((k) => (
                  <Badge tone={s.data.features[k] === "done" ? "done" : "pending"} icon={s.data.features[k] === "done" ? "check" : "clock"}>
                    {STAGES[k].tag}<span class="sr-only"> {STAGES[k].short}: {STAGE_STATE_WORD[s.data.features[k]]}</span>
                  </Badge>
                ))}
              </div>
              <p class="verdict">{s.data.verdict}</p>
              <span class="go">{s.data.stage === "building" && <Badge tone="pending">In development</Badge>}{href ? <Icon name="arrow-right" /> : <Badge tone="pending">Planned</Badge>}</span>
            </El>
          </li>
        );
      })}
    </ul>
    <p class="empty" data-empty hidden>Nothing in this group yet. <button type="button" data-filter-reset>Show all strategies</button></p>
  </div>
</div>
<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-strategy-index]")) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const rows = [...root.querySelectorAll<HTMLElement>("[data-stage]")];
    const empty = root.querySelector<HTMLElement>("[data-empty]");
    const apply = (b: HTMLButtonElement) => {
      const f = b.dataset.filter;
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      rows.forEach((r) => (r.hidden = f !== "all" && r.dataset.stage !== f));
      if (empty) empty.hidden = rows.some((r) => !r.hidden);
    };
    buttons.forEach((b) => b.addEventListener("click", () => apply(b)));
    root.querySelector("[data-filter-reset]")?.addEventListener("click", () => {
      const all = buttons.find((b) => b.dataset.filter === "all");
      if (all) { apply(all); all.focus(); }
    });
  }
</script>
<style>
  .terminal {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    text-align: left;
  }
  .side {
    padding: 1.1rem 0.75rem;
    border-right: 1px solid var(--line);
    background: var(--panel);
    font-size: 0.8125rem;
  }
  .side-h {
    padding: 0 0.6rem;
    margin: 0 0 0.4rem;
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--ink-3);
  }
  .side ul {
    margin: 0 0 1.2rem;
    padding: 0;
    list-style: none;
  }
  .side button {
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding: 0.4rem 0.6rem;
    border: 0;
    border-radius: 6px;
    font: inherit;
    color: var(--ink-2);
    background: transparent;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s;
  }
  .side button:hover {
    color: var(--ink);
    background: var(--panel-2);
  }
  .side button[aria-pressed="true"] {
    color: var(--ink);
    background: var(--panel-3);
  }
  .market {
    padding: 0 0.6rem;
    color: var(--ink-2);
  }
  .titlebar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.95rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .tb-h {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0;
  }
  .legend {
    font-size: 0.75rem;
    color: var(--ink-3);
    text-align: right;
  }
  .legend .mono {
    color: var(--ink-2);
  }
  .empty {
    padding: 1.5rem 1.25rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .empty button {
    margin-left: 0.4rem;
    padding: 0;
    border: 0;
    font: inherit;
    color: var(--ink);
    background: none;
    text-decoration: underline;
    text-decoration-color: var(--line-3);
    text-underline-offset: 0.22em;
    cursor: pointer;
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows li + li {
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.05rem 1.25rem;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .row.link:hover {
    background: var(--panel-2);
  }
  .row.link:hover .go {
    color: var(--ink);
    transform: translateX(3px);
  }
  .name {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .title {
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .summary {
    font-size: 0.8125rem;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    max-width: 17rem;
  }
  .verdict {
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .go {
    justify-self: end;
    color: var(--ink-3);
    transition: transform 0.3s var(--ease-out), color 0.2s;
  }
  @media (max-width: 900px) {
    .terminal {
      grid-template-columns: minmax(0, 1fr);
    }
    .side {
      display: flex;
      padding: 0.6rem 0.75rem;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .side-h,
    .market-h,
    .market {
      display: none;
    }
    .side .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
      margin: 0;
    }
    .side button {
      width: auto;
      min-height: 36px;
      align-items: center;
      gap: 0.6rem;
    }
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.6rem 1rem;
    }
    .chips,
    .verdict {
      grid-column: 1;
    }
    .go {
      grid-row: 1;
      grid-column: 2;
    }
    .titlebar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
    .legend {
      text-align: left;
    }
  }
</style>
