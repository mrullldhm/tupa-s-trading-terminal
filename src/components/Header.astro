---
import Logo from "./Logo.astro";
const path = Astro.url.pathname;
const links = [
  { href: "/strategies/", label: "Strategies" },
  { href: "/method/", label: "Method" },
  { href: "/journal/", label: "Journal" },
  { href: "/about/", label: "About" },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Tupa's Trading Terminal, home">
      <Logo />
      <span>Tupa's Trading Terminal</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={path.startsWith(l.href) ? "page" : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(7 7 7 / 0.78);
    backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 500;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: block;
    padding: 0.45rem 0.8rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.2s, background-color 0.2s;
  }
  nav a:hover {
    color: var(--ink);
    background: var(--panel-2);
  }
  nav a[aria-current="page"] {
    color: var(--ink);
    background: var(--panel-2);
    box-shadow: 0 0 0 1px var(--line) inset;
  }
  @media (max-width: 720px) {
    .bar {
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
      padding: 0.8rem 0 0.55rem;
    }
    nav {
      width: 100%;
      overflow-x: auto;
    }
    ul {
      margin-left: -0.8rem;
    }
  }
</style>
