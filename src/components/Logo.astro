---
// Mark: a rounded tile holding one candle that crosses a blue target line.
interface Props { size?: number }
const { size = 28 } = Astro.props;
---
<svg class="mark" width={size} height={size} viewBox="0 0 28 28" aria-hidden="true">
  <rect x="1" y="1" width="26" height="26" rx="8" fill="#1a1d26" stroke="rgb(255 255 255 / .16)" />
  <path d="M6 11h16" stroke="#5b8cff" stroke-width="1.6" stroke-linecap="round" />
  <path d="M14 5.5v17" stroke="#f6f7f9" stroke-width="1.6" stroke-linecap="round" />
  <rect x="11" y="9" width="6" height="9" rx="1.5" fill="#f6f7f9" />
</svg>
