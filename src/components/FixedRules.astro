---
const rules = [
  { k: "Market", v: "CL1!", d: "Front-month crude oil futures. Nothing else." },
  { k: "Bars", v: "1 minute", d: "Fills follow TradingView's order of open, near extreme, far extreme, close." },
  { k: "Capital · size", v: "$50,000 · 1 contract", d: "One position at a time. 1 tick = $10." },
  { k: "Commission", v: "$2.01 per order", d: "$4.02 for every round trip, included in every number." },
  { k: "Slippage", v: "0 · 1 · 2 ticks", d: "Shown separately. Market and stop orders slip, limit orders never do." },
];
---
<dl class="spec">
  {rules.map((r) => (
    <div>
      <dt>{r.k}</dt>
      <dd class="v mono">{r.v}</dd>
      <dd class="d">{r.d}</dd>
    </div>
  ))}
</dl>
<style>
  .spec {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--line-2);
    border-bottom: 1px solid var(--line-2);
  }
  .spec > div {
    padding: 1.4rem 1.25rem 1.5rem 0;
  }
  .spec > div + div {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
  }
  dt {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  dd {
    margin: 0;
  }
  .v {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    color: var(--ink);
  }
  .d {
    margin-top: 0.45rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  @media (max-width: 980px) {
    .spec {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .spec > div,
    .spec > div + div {
      padding: 1.1rem 1rem 1.1rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
