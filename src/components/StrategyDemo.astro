---
// One worked example trade on made-up candles, replayed step by step inside a chart-app frame (trading-app look:
// toolbar, OHLC legend, volume, last-price tag, side panel). Server-drawn SVG; stepping, autoplay and the
// live legend come from demo.client.ts. Without JS every step and every layer shows at once.
import Icon from "./Icon.astro";
import { stepsFor, stopMoved, tfWords, type Demo } from "../data/demos";
import { usd } from "../lib/format";

interface Props { demo: Demo; name: string }
const { demo: d, name } = Astro.props;
const t = d.trade;
const steps = stepsFor(d);
const N = d.candles.length;
const last = d.candles[N - 1];

// --- legend items: price-pane overlays merged by name (Supertrend up/down is one line), then pane lines ---
const base = (n: string) => n.split(" (")[0];
const groups = new Map<string, typeof d.overlays>();
for (const o of d.overlays) groups.set(base(o.name), [...(groups.get(base(o.name)) ?? []), o]);
const overlayItems = [...groups.values()].map((g) => ({
  name: g.length > 1 ? base(g[0].name) : g[0].name,
  color: g[0].color,
  dash: !!g[0].dash,
  values: g[0].values.map((_, i) => g.map((o) => o.values[i]).find((v) => v != null) ?? null),
}));
const dpOf = (vals: (number | null)[], paneKey?: string) =>
  paneKey === "rsi" || paneKey === "hm" ? 1 : vals.some((v) => v != null && Math.abs(v) < 5) ? 3 : 2;

// --- geometry (viewBox units; vertical units equal CSS px because the plot height is fixed) ---
const W = 1000, PL = 0, PR = 64, PH = 92, GAP = 28, XB = 24;
// level lines far from the candles stay off the chart; the legend names them instead
const hlines = d.marks.filter((m) => m.kind === "hline");
const cLo0 = Math.min(...d.candles.map((c) => c.l)), cHi0 = Math.max(...d.candles.map((c) => c.h));
const isNear = (v: number) => v >= cLo0 - (cHi0 - cLo0) * 0.6 && v <= cHi0 + (cHi0 - cLo0) * 0.6;
const offChart = hlines.filter((m) => !m.faint && !isNear(m.price!));
const onChart = hlines.filter((m) => isNear(m.price!));
// room for the legend block: OHLC row, one row per indicator (or one note row), one per off-chart level
const MT = 34 + (Math.max(1, overlayItems.length) + offChart.length) * 18;
const MH = 300 + MT;
const VOL = 44; // volume band at the bottom of the price pane
const H = MH + d.panes.length * (GAP + PH) + XB;
const slot = (W - PL - PR) / N;
const bw = Math.max(1.2, slot * 0.66);
const x = (i: number) => PL + (i + 0.5) * slot;
const xl = (i: number) => x(i) - slot / 2;
const xr = (i: number) => x(i) + slot / 2;
const pctX = (v: number) => `${(v / W) * 100}%`;

// price range: candles, overlays, trade levels and marks near the candles
const vals: number[] = d.candles.flatMap((c) => [c.h, c.l]);
for (const o of d.overlays) for (const v of o.values) if (v != null) vals.push(v);
vals.push(t.limit, t.stop, t.exit, ...(t.target != null ? [t.target] : []), ...t.stop_path.flatMap((p) => (p[1] == null ? [] : [p[1]])));


for (const m of onChart) if (!m.faint) vals.push(m.price!);
for (const m of d.marks) if (m.lo != null) vals.push(m.lo, m.hi!);
let lo = Math.min(...vals), hi = Math.max(...vals);
const padP = (hi - lo) * 0.06 || 0.05;
lo -= padP; hi += padP;
const PB = MH - VOL * 0.55; // price area bottom; volume tucks under the lowest candles
const y = (v: number) => MT + (1 - (v - lo) / (hi - lo)) * (PB - MT);
const raw = (hi - lo) / 7, mag = 10 ** Math.floor(Math.log10(raw));
const pstep = [1, 2, 2.5, 5, 10].map((k) => k * mag).find((k) => k >= raw)!;
const pticks: number[] = [];
for (let v = Math.ceil(lo / pstep) * pstep; v <= hi; v += pstep) pticks.push(+v.toFixed(4));
const vmax = Math.max(...d.candles.map((c) => c.v), 1);

// sub panes
const panes = d.panes.map((p, k) => {
  const top = MH + k * (GAP + PH) + GAP;
  const pv = p.lines.flatMap((l) => l.values.filter((v): v is number => v != null)).concat(p.guides.map((g) => g.v));
  let plo = p.lo ?? Math.min(...pv), phi = p.hi ?? Math.max(...pv);
  if (p.lo == null) { const pad = (phi - plo) * 0.1 || 0.01; plo -= pad; phi += pad; }
  const py = (v: number) => top + 4 + (1 - (v - plo) / (phi - plo)) * (PH - 8);
  return { ...p, top, py };
});

const pathOf = (vs: (number | null)[], fy: (v: number) => number, step = false) => {
  let s = "", pen = false;
  vs.forEach((v, i) => {
    if (v == null) { pen = false; return; }
    if (step) s += `${pen ? "L" : "M"}${xl(i).toFixed(1)},${fy(v).toFixed(1)}L${xr(i).toFixed(1)},${fy(v).toFixed(1)}`;
    else s += `${pen ? "L" : "M"}${x(i).toFixed(1)},${fy(v).toFixed(1)}`;
    pen = true;
  });
  return s;
};

// x-axis: a label every few candles, plus day changes
const every = Math.ceil(N / 7);
const days = d.candles.map((c, i) => ({ i, c })).filter(({ c }) => c.nd);
const xlabels = d.candles.map((c, i) => ({ i, c }))
  .filter(({ i, c }) => c.nd || (i % every === Math.floor(every / 2) && days.every((z) => Math.abs(z.i - i) > every * 0.7)));

const partI = t.part_exit != null ? (() => {
  for (let i = t.entry_i; i <= t.exit_i; i++) { const c = d.candles[i]; if (c.l <= t.part_exit! && c.h >= t.part_exit!) return i; }
  return null;
})() : null;
const moved = stopMoved(t);
// Stop path: [position in candles, stop] where each change took effect (intrabar, from the 1m bar), last = exit.
const px = (p: number) => (PL + p * slot).toFixed(1);
const stopD = t.stop_path.map(([p, v], k) => {
  if (k === 0) return `M${px(p)},${y(v!).toFixed(1)}`;
  const prev = t.stop_path[k - 1][1]!;
  return v == null ? `H${px(p)}` : `H${px(p)}M${px(p)},${y(prev).toFixed(1)}V${y(v).toFixed(1)}`;
}).join("");
const buy = t.side === 1;
const tgtOn = t.target != null;
const symbol = "CL";
// axis tags for the order: pushed apart (top to bottom) so close levels never overlap
const TAG_GAP = 17;
const tradeTags = [
  ...(tgtOn ? [{ cls: "tgt", label: "Target", price: t.target! }] : []),
  { cls: "ent", label: buy ? "Buy" : "Sell", price: t.limit },
  { cls: "stp", label: "Stop", price: t.stop },
].map((g) => ({ ...g, top: y(g.price) })).sort((a, b) => a.top - b.top);
for (let k = 1; k < tradeTags.length; k++) tradeTags[k].top = Math.max(tradeTags[k].top, tradeTags[k - 1].top + TAG_GAP);
const levelsOnly = !overlayItems.length && d.marks.some((m) => m.kind === "hline");

const paneItems = panes.flatMap((p) => p.lines.map((l) => ({ name: l.name, color: l.color, values: l.values, dp: dpOf(l.values, p.key) })));
const items = [
  ...overlayItems.map((o) => ({ v: o.values, dp: 2 })),
  ...paneItems.map((l) => ({ v: l.values, dp: l.dp })),
];
const fmt = (v: number | null, dp: number) => (v == null ? "–" : v.toFixed(dp));
const chg = (i: number) => {
  const c = d.candles[i], prev = i > 0 ? d.candles[i - 1].c : c.o;
  const ch = c.c - prev;
  return `${ch >= 0 ? "+" : "−"}${Math.abs(ch).toFixed(2)} (${ch >= 0 ? "+" : "−"}${Math.abs((ch / prev) * 100).toFixed(2)}%)`;
};
const payload = JSON.stringify({
  W, PL, PR, N, MT, PB, lo, hi,
  c: d.candles.map((c) => [c.o, c.h, c.l, c.c, `${c.d} ${c.t}`]),
  items,
  steps: steps.map((s) => ({ at: s.at, show: s.show })),
});
---
<figure class="demo" data-demo={payload} style={`--h:${H}px`}>
  <div class="frame">
    <div class="tb">
      <span class="sym"><i aria-hidden="true">{symbol}</i><b>{symbol}</b><span class="faint">Crude oil · made-up</span></span>
      <span class="chip num">{d.tf}</span>
      <span class="sep" aria-hidden="true"></span>
      <button type="button" class="tbtn" data-ind aria-pressed="true" disabled={!overlayItems.length && !panes.length} title="Show or hide the indicators">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 12.5 6 7l3 3 5-6.5" /></svg>
        <span>Indicators</span><span class="cnt num">{overlayItems.length + paneItems.length}</span>
      </button>
      <button type="button" class="tbtn" data-play hidden title="Play the steps one after another">
        <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3 3 8l5 5M13 3 8 8l5 5" /></svg>
        <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5v9M10.5 3.5v9" /></svg>
        <span class="lbl">Replay</span>
      </button>
      <span class="grow"></span>
      <span class="flag"><Icon name="warn" size={12} />Made-up candles</span>
    </div>

    <div class="body">

      <div class="chart">
        <div class="plot" role="img" aria-label={`Worked example of ${name} on made-up ${tfWords(d.tf)} candles: a ${buy ? "buy" : "sell"} at ${usd(t.entry, { sign: false, cents: true })}, closed at ${usd(t.exit, { sign: false, cents: true })} for ${usd(t.net, { cents: true })}.`}>
          <div class="wm" aria-hidden="true" style={`top:${(MT + PB) / 2}px`}>{symbol} · {d.tf}</div>
          <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <clipPath id={`clip-${d.id}`}><rect x={PL} y="0" width={W - PL - PR} height={MH} /></clipPath>
            </defs>
            {pticks.map((v) => <line class="grid" x1={PL} x2={W - PR} y1={y(v)} y2={y(v)} vector-effect="non-scaling-stroke" />)}
            {xlabels.map(({ i }) => <line class="grid" x1={x(i)} x2={x(i)} y1="0" y2={H - XB} vector-effect="non-scaling-stroke" />)}
            {days.map(({ i }) => <line class="day" x1={xl(i)} x2={xl(i)} y1="0" y2={H - XB} vector-effect="non-scaling-stroke" />)}
            <line class="axis" x1={W - PR} x2={W - PR} y1="0" y2={H} vector-effect="non-scaling-stroke" />
            <line class="axis" x1="0" x2={W} y1={H - XB} y2={H - XB} vector-effect="non-scaling-stroke" />

            <g clip-path={`url(#clip-${d.id})`}>
              {d.marks.filter((m) => m.kind === "candle").map((m) => (
                <rect class="ly hl" data-ly={m.layer} x={xl(m.i!)} width={slot} y="0" height={MH} />
              ))}
              {/* volume */}
              {d.candles.map((c, i) => (
                <rect class:list={["vol", c.c >= c.o ? "up" : "dn"]} x={x(i) - bw / 2} width={bw} y={MH - (c.v / vmax) * VOL} height={(c.v / vmax) * VOL} />
              ))}
              {/* trade zones */}
              <g class="ly" data-ly="order">
                <rect class="zone-stop" x={xr(t.signal)} width={xr(t.exit_i) - xr(t.signal)} y={Math.min(y(t.limit), y(t.stop))} height={Math.abs(y(t.limit) - y(t.stop))} />
                {tgtOn && <rect class="zone-tgt" x={xr(t.signal)} width={xr(t.exit_i) - xr(t.signal)} y={Math.min(y(t.limit), y(t.target!))} height={Math.abs(y(t.limit) - y(t.target!))} />}
                <line class="lvl-stop" x1={xr(t.signal)} x2={xr(t.exit_i)} y1={y(t.stop)} y2={y(t.stop)} vector-effect="non-scaling-stroke" />
                {tgtOn && <line class="lvl-tgt" x1={xr(t.signal)} x2={xr(t.exit_i)} y1={y(t.target!)} y2={y(t.target!)} vector-effect="non-scaling-stroke" />}
                <line class="lvl-wait" x1={xr(t.signal)} x2={xl(t.entry_i)} y1={y(t.limit)} y2={y(t.limit)} vector-effect="non-scaling-stroke" />
              </g>
              <line class="ly lvl-entry" data-ly="fill" x1={xl(t.entry_i)} x2={xr(t.exit_i)} y1={y(t.entry)} y2={y(t.entry)} vector-effect="non-scaling-stroke" />
              {d.marks.filter((m) => m.kind === "hline").map((m) => (
                <line class:list={["ly", "lvl", m.faint && "faint"]} data-ly={m.layer} x1={xl(m.from!)} x2={xr(m.to!)} y1={y(m.price!)} y2={y(m.price!)} vector-effect="non-scaling-stroke" />
              ))}
              {d.marks.filter((m) => m.kind === "zone").map((m) => (
                <rect class:list={["ly", "mz", m.tone]} data-ly={m.layer} x={xl(m.i0!)} width={xr(m.i1!) - xl(m.i0!)} y={y(m.hi!)} height={Math.max(1, y(m.lo!) - y(m.hi!))} vector-effect="non-scaling-stroke" />
              ))}
              <g class="ind">
                {d.overlays.map((o) => (
                  <path class:list={["ov", o.dash && "dash"]} d={pathOf(o.values, y, o.step)} stroke={o.color} vector-effect="non-scaling-stroke" />
                ))}
              </g>
              {d.candles.map((c, i) => {
                const up = c.c >= c.o;
                const top = y(Math.max(c.o, c.c)), bot = y(Math.min(c.o, c.c));
                return (
                  <g class:list={["cd", up ? "up" : "dn"]}>
                    <line x1={x(i)} x2={x(i)} y1={y(c.h)} y2={y(c.l)} vector-effect="non-scaling-stroke" />
                    <rect x={x(i) - bw / 2} width={bw} y={top} height={Math.max(1, bot - top)} />
                  </g>
                );
              })}
              {moved && <path class="ly stop-path" data-ly="manage" d={stopD} vector-effect="non-scaling-stroke" />}
              <line class="lastline" x1={PL} x2={W - PR} y1={y(last.c)} y2={y(last.c)} vector-effect="non-scaling-stroke" />
            </g>

            {panes.map((p) => (
              <g>
                <line class="axis" x1="0" x2={W - PR} y1={p.top - GAP} y2={p.top - GAP} vector-effect="non-scaling-stroke" />
                {p.guides.map((g) => <line class="guide" x1={PL} x2={W - PR} y1={p.py(g.v)} y2={p.py(g.v)} vector-effect="non-scaling-stroke" />)}
                {d.marks.filter((m) => m.kind === "candle").map((m) => (
                  <rect class="ly hl" data-ly={m.layer} x={xl(m.i!)} width={slot} y={p.top - GAP} height={PH + GAP} />
                ))}
                <g class="ind">{p.lines.map((l) => <path class="ov" d={pathOf(l.values, p.py)} stroke={l.color} vector-effect="non-scaling-stroke" />)}</g>
              </g>
            ))}
            <line class="cross" x1="0" x2="0" y1="0" y2={H - XB} vector-effect="non-scaling-stroke" />
          </svg>

          {/* legend: symbol line with OHLC, then one row per indicator with its value at the cursor */}
          <div class="lgd">
            <div class="ohlc num">
              <b>{symbol} · {d.tf}</b>
              <span>O <em data-o>{last.o.toFixed(2)}</em></span>
              <span>H <em data-h>{last.h.toFixed(2)}</em></span>
              <span>L <em data-l>{last.l.toFixed(2)}</em></span>
              <span>C <em data-c>{last.c.toFixed(2)}</em></span>
              <span class="chg" data-chg>{chg(N - 1)}</span>
            </div>
            {overlayItems.map((o, k) => (
              <div class="li ind">
                <i class:list={[o.dash && "dash"]} style={o.dash ? `border-top-color:${o.color}` : `background:${o.color}`}></i>
                <span>{o.name}</span><em class="num" data-li={k} style={`color:${o.color}`}>{fmt(o.values[N - 1], 2)}</em>
              </div>
            ))}
            {levelsOnly && <div class="li faint">Dotted lines: price levels from the rules</div>}
            {offChart.map((m) => (
              <div class="li ly faint" data-ly={m.layer}>{m.price! > hi ? "↑" : "↓"} {m.label} {m.price!.toFixed(2)}, {m.price! > hi ? "above" : "below"} the chart</div>
            ))}
            {!overlayItems.length && !levelsOnly && <div class="li faint">Candles only, no indicators</div>}
          </div>
          {panes.map((p, k) => {
            const offset = overlayItems.length + panes.slice(0, k).reduce((n, q) => n + q.lines.length, 0);
            return (
              <div class="ptitle" style={`top:${p.top - GAP + 6}px`}>
                <b>{p.title}</b>
                {p.lines.map((l, j) => (
                  <span><i style={`background:${l.color}`}></i>{p.lines.length > 1 && l.name}<em class="num" data-li={offset + j} style={`color:${l.color}`}>{fmt(l.values[N - 1], dpOf(l.values, p.key))}</em></span>
                ))}
              </div>
            );
          })}

          <div class="yax" aria-hidden="true">
            {pticks.map((v) => <span style={`top:${y(v)}px`}>{v.toFixed(2)}</span>)}
            {panes.flatMap((p) => p.guides.map((g) => <span style={`top:${p.py(g.v)}px`}>{g.label}</span>))}
          </div>
          <div class="tags" aria-hidden="true">
            {tradeTags.map((g) => <span class:list={["tag", "ly", g.cls]} data-ly="order" style={`top:${g.top}px`}><b>{g.label}</b> {g.price.toFixed(2)}</span>)}
            <span class:list={["tag", "last", last.c >= last.o ? "up" : "dn"]} style={`top:${y(last.c)}px`}>{last.c.toFixed(2)}</span>
          </div>
          {onChart.map((m) => (
            <span class:list={["mlabel", "ly", m.faint && "faint"]} data-ly={m.layer} style={`left:${pctX(Math.max(xl(m.from!), 0) + 6)};top:${y(m.price!)}px`} aria-hidden="true">{m.label}</span>
          ))}
          {d.marks.filter((m) => m.kind === "candle").map((m) => (
            <span class="clabel ly" data-ly={m.layer} style={`left:${pctX(x(m.i!))};top:${y(d.candles[m.i!].l) + 8}px`} aria-hidden="true">{m.label}</span>
          ))}
          {d.marks.filter((m) => m.kind === "zone").map((m) => (
            <span class="clabel ly zl" data-ly={m.layer} style={`left:${pctX((xl(m.i0!) + xr(m.i1!)) / 2)};top:${y(m.hi!) - 20}px`} aria-hidden="true">{m.label}</span>
          ))}
          <span class="dot ly ent" data-ly="fill" style={`left:${pctX(x(t.entry_i))};top:${y(t.entry)}px`} aria-hidden="true"></span>
          {partI != null && <span class="dot ly part" data-ly="exit" style={`left:${pctX(x(partI))};top:${y(t.part_exit!)}px`} aria-hidden="true"></span>}
          <span class="dot ly out" data-ly="exit" style={`left:${pctX(x(t.exit_i))};top:${y(t.exit)}px`} aria-hidden="true"></span>
          <span class="exit-tag ly num" data-ly="exit" style={`left:${pctX(x(t.exit_i))};top:${y(t.exit)}px`} aria-hidden="true">{usd(t.net, { cents: true })}</span>
          <div class="xax" aria-hidden="true">
            {xlabels.map(({ i, c }, k) => <span class:list={[c.nd && "nd", !c.nd && k % 2 === 1 && "odd"]} style={`left:${pctX(x(i))}`}>{c.nd ? `${c.d} ${c.t}` : c.t}</span>)}
          </div>
          <div class="curtain" style={`right:${pctX(PR)};bottom:${XB}px`} aria-hidden="true" hidden><span>Not happened yet</span></div>
        </div>
        <div class="sb">
          <span>{tfWords(d.tf)} candles · replay</span>
          <span class="grow"></span>
          <span class="num" data-clock>{last.d} {last.t}</span><span class="faint">Chicago</span>
        </div>
      </div>

      <div class="panel-side">
        <div class="ps-head">
          <b>Step by step</b>
          <div class="ctl">
            <button type="button" class="ib" data-go="-1" aria-label="Previous step" hidden><Icon name="back" size={14} /></button>
            <span class="count num" aria-live="polite" hidden></span>
            <button type="button" class="ib" data-go="1" aria-label="Next step" hidden><Icon name="arrow" size={14} /></button>
          </div>
        </div>
        <ol class="steps">
          {steps.map((s, k) => (
            <li data-k={k}>
              <button type="button" class="st" data-k={k}><span class="n num">{k + 1}</span><span>{s.title}</span></button>
              <div class="body-t">
                <p>{s.text}</p>
                {s.checks && (
                  <ul class="checks">
                    {s.checks.map((c) => (
                      <li class:list={[c.ok ? "ok" : "no"]}>
                        <Icon name={c.ok ? "check" : "cross"} size={14} />
                        <span class="cl">{c.label}</span>
                        <span class="cv num">{c.value}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
  <figcaption class="caption">
    <b>Made-up candles, real rules.</b> These {tfWords(d.tf)} candles are not real oil prices (we may not publish market
    data). The signal, fill and exit come from the same strategy code and engine as the tests. Times are Chicago. One
    example shows how the rules work, not whether they make money: see the results below.
  </figcaption>
</figure>
<script src="../lib/demo.client.ts"></script>
<style>
  .demo { margin: 0; --up: #22ab94; --dn: #f23645; --chart: #0b0c0f; }
  .frame { border: 1px solid var(--line-hi); border-radius: var(--r-lg); background: var(--chart); overflow: hidden; }

  /* toolbar */
  .tb { display: flex; align-items: center; gap: 0.4rem; height: 2.75rem; padding: 0 0.6rem; border-bottom: 1px solid var(--line); font-size: 0.8rem; }
  .sym { display: inline-flex; align-items: center; gap: 0.5rem; padding-right: 0.3rem; white-space: nowrap; }
  .sym i {
    display: grid; place-items: center; width: 1.35rem; height: 1.35rem; border-radius: 50%; font-style: normal;
    font-size: 0.55rem; font-weight: 700; color: var(--btn-ink); background: var(--btn);
  }
  .sym b { font-weight: 600; }
