---
import Frame from "./Frame.astro";
type Tone = "ink" | "dim" | "faint" | "long";
interface Props {
  series: { label: string; tone: Tone; points: [string, number][] }[];
  title: string;
  caption: string;
}
import { usd } from "../lib/format";
const { series, title, caption } = Astro.props;
// Text alternative: the exported month-end points as a table, one column per series. No values are derived.
const months = [...new Set(series.flatMap((s) => s.points.map(([m]) => m)))].sort();
const byMonth = series.map((s) => new Map(s.points));
---
<figure class="curve">
  <Frame>
    <div class="head">
      <p class="title">{title}</p>
      <ul class="legend">
        {series.map((s) => <li class={s.tone}><span class="sw"></span>{s.label}</li>)}
      </ul>
    </div>
    <div data-chart="curves" data-series={JSON.stringify(series)}>
      <div class="canvas" data-canvas role="img" aria-label={`${title}. ${caption}`}></div>
    </div>
  </Frame>
  <figcaption>{caption}</figcaption>
  <details class="numbers">
    <summary>Show the numbers <span class="muted">({months.length} months)</span></summary>
    <div class="table-scroll">
      <table class="data">
        <caption class="sr-only">{title}, month-end values</caption>
        <thead><tr><th scope="col">Month</th>{series.map((s) => <th scope="col" class="num">{s.label}</th>)}</tr></thead>
        <tbody>
          {months.map((m) => (
            <tr>
              <th scope="row" class="mono">{m}</th>
              {byMonth.map((map) => {
                const v = map.get(m);
                return <td class="num">{v === undefined ? <span aria-label="no value">–</span> : usd(v, { cents: false })}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>
<script>
  import "../lib/charts.client";
</script>
<style>
  .curve {
    margin: 0;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .title {
    font-size: 0.875rem;
    font-weight: 500;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .sw {
    width: 18px;
    height: 0;
    border-top: 2px solid #f9f9f9;
  }
  .dim .sw {
    border-top: 2px solid rgb(249 249 249 / 0.5);
  }
  .faint .sw {
    border-top: 2px dashed rgb(249 249 249 / 0.32);
  }
  .long .sw {
    border-top-color: var(--long);
  }
  .canvas {
    min-width: 0;
    overflow: hidden;
    height: 320px;
    padding: 0.5rem 0;
  }
  .numbers {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }
  .numbers summary {
    display: inline-flex;
    gap: 0.35rem;
    min-height: 40px;
    align-items: center;
    color: var(--ink-2);
    cursor: pointer;
  }
  .numbers summary:hover {
    color: var(--ink);
  }
  .numbers .table-scroll {
    max-height: 420px;
    overflow: auto;
    margin-top: 0.5rem;
  }
  .numbers thead th {
    position: sticky;
    top: 0;
  }
  figcaption {
    margin-top: 0.7rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
    max-width: var(--measure);
  }
</style>
